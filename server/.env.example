# ==========================================
# FLOWDESK BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Connection String)
# Example: mongodb://localhost:27017/flowdesk or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/flowdesk

# JWT Secrets (Use high-entropy random strings in production)
JWT_ACCESS_SECRET=flowdesk_super_secret_access_key_development_2026_xyz!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=flowdesk_super_secret_refresh_key_development_2026_xyz!
JWT_REFRESH_EXPIRES_IN=7d

# Paystack API Keys (Obtain from https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=sk_test_placeholder_key_here
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key_here

# Cloudinary Storage (Obtain from https://console.cloudinary.com/)
CLOUDINARY_CLOUD_NAME=flowdesk_cloud
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# AI API (e.g. OpenAI / Groq / Google Gemini API Key)
AI_API_KEY=placeholder_ai_api_key

# Email SMTP (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=placeholder_smtp_user
SMTP_PASS=placeholder_smtp_password
EMAIL_FROM=FlowDesk <noreply@flowdesk.app>

